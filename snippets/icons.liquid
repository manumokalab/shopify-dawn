{%- liquid
  assign icons_set = settings.icons_set
  assign icons_color = settings.icons_color
-%}

<span class="svg-wrapper variable-icon-color">
  {%- if icon == 'search' -%}
    {%- if icons_set == 'default' -%}
      {{- 'icon-search.svg' | inline_asset_content -}}
    {%- elsif icons_set == 'bold' -%}
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 24px;">
        <path d="M11 6C13.7614 6 16 8.23858 16 11M16.6588 16.6549L21 21M19 11C19 15.4183 15.4183 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- elsif icons_set == 'thin' -%}
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 32px; height: 32px;">
        <g clip-path="url(#clip0_15_152)">
          <rect width="24" height="24"/>
          <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-linejoin="round"/>
          <path d="M19.6464 20.3536C19.8417 20.5488 20.1583 20.5488 20.3536 20.3536C20.5488 20.1583 20.5488 19.8417 20.3536 19.6464L19.6464 20.3536ZM20.3536 19.6464L15.3536 14.6464L14.6464 15.3536L19.6464 20.3536L20.3536 19.6464Z" fill="currentColor"/>
        </g>
        <defs>
        <clipPath id="clip0_15_152">
        <rect width="24" height="24" fill="white"/>
        </clipPath>
        </defs>
      </svg>
    {%- endif -%}
  {%- endif -%}

  {%- if icon == 'account' -%}
    {%- if icons_set == 'default' -%}
      {{- 'icon-account.svg' | inline_asset_content -}}
    {%- elsif icons_set == 'bold' -%}
      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 24px;">
        <path d="M8 7C9.65685 7 11 5.65685 11 4C11 2.34315 9.65685 1 8 1C6.34315 1 5 2.34315 5 4C5 5.65685 6.34315 7 8 7Z" fill="currentColor"/>
        <path d="M14 12C14 10.3431 12.6569 9 11 9H5C3.34315 9 2 10.3431 2 12V15H14V12Z" fill="currentColor"/>
      </svg>
    {%- elsif icons_set == 'thin' -%}
      <svg
        viewBox="0 0 32 32"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        style="width: 24px; height: 24px;"
      >
        <path d="M16 16.75c4.28 0 7.75-3.47 7.75-7.75s-3.47-7.75-7.75-7.75c-4.28 0-7.75 3.47-7.75 7.75v0c0.005 4.278 3.472 7.745 7.75 7.75h0zM16 2.75c3.452 0 6.25 2.798 6.25 6.25s-2.798 6.25-6.25 6.25c-3.452 0-6.25-2.798-6.25-6.25v0c0.004-3.45 2.8-6.246 6.25-6.25h0zM30.41 29.84c-1.503-6.677-7.383-11.59-14.41-11.59s-12.907 4.913-14.391 11.491l-0.019 0.099c-0.011 0.048-0.017 0.103-0.017 0.16 0 0.414 0.336 0.75 0.75 0.75 0.357 0 0.656-0.25 0.731-0.585l0.001-0.005c1.351-5.998 6.633-10.41 12.945-10.41s11.594 4.413 12.929 10.322l0.017 0.089c0.076 0.34 0.374 0.59 0.732 0.59 0 0 0.001 0 0.001 0h-0c0.057-0 0.112-0.007 0.165-0.019l-0.005 0.001c0.34-0.076 0.59-0.375 0.59-0.733 0-0.057-0.006-0.112-0.018-0.165l0.001 0.005z"></path>
      </svg>
    {%- endif -%}
  {%- endif -%}

  {%- if icon == 'cart' -%}
    {%- if icons_set == 'default' -%}
      {{- 'icon-cart.svg' | inline_asset_content -}}
    {%- elsif icons_set == 'bold' -%}
      <svg viewBox="0 -1 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 24px;">
        <g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd" sketch:type="MSPage">
            <g id="Icon-Set-Filled" sketch:type="MSLayerGroup" transform="translate(-466.000000, -726.000000)" fill="#000000">
                <path d="M475.97,734 L473.475,726 L467,726 C466.447,726 466,726.448 466,727 C466,727.553 466.447,728 467,728 L472,728 L474.011,734 L474,734 L476,746 C476,748.209 477.791,750 480,750 L491,750 C493.209,750 495,748.209 495,746 L498,734 L475.97,734 L475.97,734 Z M490,752 C488.896,752 488,752.896 488,754 C488,755.104 488.896,756 490,756 C491.104,756 492,755.104 492,754 C492,752.896 491.104,752 490,752 L490,752 Z M480,752 C478.896,752 478,752.896 478,754 C478,755.104 478.896,756 480,756 C481.104,756 482,755.104 482,754 C482,752.896 481.104,752 480,752 L480,752 Z" id="cart" sketch:type="MSShapeGroup"></path>
            </g>
        </g>
      </svg>
    {%- elsif icons_set == 'thin' -%}
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 32px; height: 32px;">
        <circle cx="10" cy="19" r="1.5" stroke="currentColor"/>
        <circle cx="17" cy="19" r="1.5" stroke="currentColor"/>
        <path d="M3.5 4H5.5L9.00446 15H17" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M8.22445 12.5L6.29862 6.5H18.8063C19.1476 6.5 19.3885 6.83435 19.2806 7.15811L17.614 12.1581C17.5459 12.3623 17.3548 12.5 17.1396 12.5H8.22445Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- endif -%}
  {%- endif -%}

  {%- if icon == 'cart-empty' -%}
    {%- if icons_set == 'default' -%}
      {{- 'icon-cart-empty.svg' | inline_asset_content -}}
    {%- elsif icons_set == 'bold' -%}
      <svg viewBox="0 -1 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 24px;">
        <g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd" sketch:type="MSPage">
            <g id="Icon-Set-Filled" sketch:type="MSLayerGroup" transform="translate(-466.000000, -726.000000)" fill="currentColor">
                <path d="M475.97,734 L473.475,726 L467,726 C466.447,726 466,726.448 466,727 C466,727.553 466.447,728 467,728 L472,728 L474.011,734 L474,734 L476,746 C476,748.209 477.791,750 480,750 L491,750 C493.209,750 495,748.209 495,746 L498,734 L475.97,734 L475.97,734 Z M490,752 C488.896,752 488,752.896 488,754 C488,755.104 488.896,756 490,756 C491.104,756 492,755.104 492,754 C492,752.896 491.104,752 490,752 L490,752 Z M480,752 C478.896,752 478,752.896 478,754 C478,755.104 478.896,756 480,756 C481.104,756 482,755.104 482,754 C482,752.896 481.104,752 480,752 L480,752 Z" id="cart" sketch:type="MSShapeGroup"></path>
            </g>
        </g>
      </svg>
    {%- elsif icons_set == 'thin' -%}
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 32px; height: 32px;">
        <circle cx="10" cy="19" r="1.5" stroke="currentColor"/>
        <circle cx="17" cy="19" r="1.5" stroke="currentColor"/>
        <path d="M3.5 4H5.5L9.00446 15H17" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M8.22445 12.5L6.29862 6.5H18.8063C19.1476 6.5 19.3885 6.83435 19.2806 7.15811L17.614 12.1581C17.5459 12.3623 17.3548 12.5 17.1396 12.5H8.22445Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- endif -%}
  {%- endif -%}
</span>

<style>
  .variable-icon-color svg {
    color: {{ icons_color }};
  }
</style>
